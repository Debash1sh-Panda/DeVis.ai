{
  "name": "devis-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DeVis.ai — Personal Voice & Computer AI Agent",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:worker": "pnpm --filter worker start:dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:worker": "pnpm --filter worker build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @devis/database prisma generate",
    "db:migrate": "pnpm --filter @devis/database prisma migrate dev",
    "db:studio": "node scripts/safe-studio.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
